# Frontend
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SOULHUB_SITE_URL=
VITE_SOULHUB_HOST=
VITE_SITE_MODE=
VITE_ENABLE_DEV_AUTH=
# Internal-registry mode: default the web UI to the fixed "system" admin (no login
# flow). Pair with VULTURE_DEFAULT_SYSTEM_USER=1 on the Convex backend (see below).
VITE_DEFAULT_SYSTEM_USER=
SITE_URL=http://localhost:3000
CONVEX_SITE_URL=

# Convex Auth (GitHub OAuth App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Convex Auth JWT keys (generated via @convex-dev/auth CLI)
JWT_PRIVATE_KEY=
JWKS=

# Internal-registry default identity (Convex backend env; trusted internal network).
# When =1, requests that resolve to no authenticated user fall back to the fixed
# "system" admin — mirroring the tokenless HTTP API fallback — so the reactive web
# UI is usable without a login flow. Pair with VITE_DEFAULT_SYSTEM_USER=1 above.
VULTURE_DEFAULT_SYSTEM_USER=

# Local dev personas
DEV_AUTH_ENABLED=
DEV_AUTH_CONVEX_DEPLOYMENT=
DEV_AUTH_SITE_URL=
DEV_AUTH_SECRET=

# Embeddings
OPENAI_API_KEY=

# Transactional email
RESEND_API_KEY=
CLAWHUB_SECURITY_EMAIL=security@notifications.openclaw.ai
CLAWHUB_SECURITY_EMAIL_FROM=ClawHub Security <noreply@notifications.openclaw.ai>
