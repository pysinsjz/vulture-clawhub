# Vulture/ClawHub 自托管 — 服务器侧环境变量
# 注意：本目录的 .env 文件**不进 git**（见 .gitignore），里面含 R2/MinIO 凭证。

# ---- convex 自托管核心 ----
INSTANCE_NAME=
INSTANCE_SECRET=

CONVEX_CLOUD_ORIGIN=http://8.136.147.138:3210
CONVEX_SITE_ORIGIN=http://8.136.147.138:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://8.136.147.138:3210

DISABLE_BEACON=true
ISOLATE_ANALYZE_USER_TIMEOUT_SECONDS=120

# 内网默认登入固定 system 用户（前端 VITE_DEFAULT_SYSTEM_USER 同开）
VULTURE_DEFAULT_SYSTEM_USER=1
# 跳过 plugin 发布的 plugin.json/package.json/configSchema/source/inspector 校验
# （内网精简版专用；外网严禁开启）。convex env 也要 set 一份。
VULTURE_SKIP_PLUGIN_PUBLISH_VALIDATION=1

# 构建 web SSR 时（bun run build）必须导出该变量，让 nitro 反代 /api/v1/** →
# backend 3211。不构建在 deploy 用，但记在这里方便下次 rebuild 不忘：
#   NITRO_V1_PROXY_TARGET=http://backend:3211

# ---- 制品存储（任选一种）----
# 方案 A：本地 MinIO（推荐，国内 ECS 跨境到 R2 太慢）
MINIO_ROOT_USER=vulture-root
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=vulture-root
AWS_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
S3_ENDPOINT_URL=http://8.136.147.138:9000
AWS_S3_FORCE_PATH_STYLE=true

S3_STORAGE_FILES_BUCKET=vulture-files
S3_STORAGE_MODULES_BUCKET=vulture-modules
S3_STORAGE_SEARCH_BUCKET=vulture-search
S3_STORAGE_EXPORTS_BUCKET=vulture-exports
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=vulture-imports

# 方案 B：Cloudflare R2（境外可用；国内 ECS 一般不可用）
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=true
